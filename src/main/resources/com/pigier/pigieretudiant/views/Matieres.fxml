<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<Pane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pigier.pigieretudiant.controllers.MatieresController">
    <children>
        <!-- Main Content Area -->
        <Pane prefHeight="900.0" prefWidth="1200.0">
            <children>
                <!-- Header -->
                <Pane prefHeight="60.0" prefWidth="1200.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                    <children>
                        <Label layoutX="30.0" layoutY="20.0" text="Gestion des Matières" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                    </children>
                </Pane>

                <!-- Form Section -->
                <VBox layoutX="30.0" layoutY="80.0" prefHeight="180.0" prefWidth="1140.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
                    <children>
                        <Label text="Ajouter une nouvelle matière" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>

                        <HBox spacing="15.0">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Nom de la matière:" />
                                        <TextField fx:id="nomMatiereField" prefWidth="300.0" promptText="Ex: Programmation Java" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Coefficient:" />
                                        <TextField fx:id="coefField" prefWidth="100.0" promptText="Ex: 3" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Niveau:" />
                                        <ComboBox fx:id="niveauComboBox" prefWidth="150.0" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox spacing="10.0">
                            <children>
                                <Button onAction="#ajouterMatiere" style="-fx-background-color: #28a745; -fx-text-fill: white;" text="Ajouter Matière" />
                                <Label fx:id="messageLabel" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Table Section -->
                <VBox layoutX="30.0" layoutY="280.0" prefHeight="570.0" prefWidth="1140.0" spacing="10.0">
                    <children>
                        <TableView fx:id="matieresTable" prefHeight="520.0" prefWidth="1140.0" style="-fx-background-color: white; -fx-background-radius: 10;">
                            <columns>
                                <TableColumn fx:id="colNomMatiere" prefWidth="400.0" text="Nom de la Matière" />
                                <TableColumn fx:id="colCoef" prefWidth="150.0" text="Coefficient" />
                                <TableColumn fx:id="colNiveau" prefWidth="150.0" text="Niveau" />
                                <TableColumn fx:id="colActions" prefWidth="200.0" text="Actions" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </Pane>
    </children>
</Pane>